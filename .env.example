# Copy to .env for local dev. Never commit .env. Real secrets live in Vault/OpenBao.
POSTGRES_DB=kilowatt
POSTGRES_USER=kilowatt
POSTGRES_PASSWORD=kilowatt-dev-only

KAFKA_BOOTSTRAP=localhost:9092
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql://kilowatt:kilowatt-dev-only@localhost:5432/kilowatt

# Simulator determinism (CLAUDE.md §6)
SEED=42

# ingest-gateway (compose sets broker hostnames itself). Format: id=secret:oem|oem;id2=...
# Dev-only value; real keys come from Vault/OpenBao.
GATEWAY_HMAC_KEYS=sim=dev-only-hmac-secret:oem_a|oem_b|oem_c
# Simulator HTTPS signing secret (must match the "sim" key above).
SIM_HMAC_SECRET=dev-only-hmac-secret
